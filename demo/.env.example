# Variables of the demo container. On Railway they are service variables; never commit real values.

# PostgreSQL server; the demo database (WAGTAIL_DB_NAME, default "wagtail") is created there if missing.
# Leave unset for local development with SQLite (demo/db.sqlite3).
DATABASE_URL=postgresql://user:password@localhost:5432/postgres
# WAGTAIL_DB_NAME=wagtail

DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=*
# DJANGO_DEBUG=1

# Supertext. For the stand-in API (tests/docs/stand-in.mjs) use any key and the local endpoint.
# No account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate the key at https://www.supertext.com/en/integrations/api (requires the Admin role).
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=http://127.0.0.1:8765/v1/

# Accounts created on every start if missing (existing accounts are never changed).
# Django's password rules apply: at least 8 characters, not too common, not only digits.
# DEMO_ADMIN_EMAIL=you@example.com
# DEMO_ADMIN_PASSWORD=
# The editor account is in Wagtail's Moderators group (edit, publish, translate pages).
# DEMO_EDITOR_EMAIL=editor@example.com
# DEMO_EDITOR_PASSWORD=
