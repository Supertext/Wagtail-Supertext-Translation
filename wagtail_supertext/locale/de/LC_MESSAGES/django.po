#
msgid ""
msgstr ""
"Project-Id-Version: wagtail-supertext-translation\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Supertext Translation"
msgstr "Supertext-Übersetzung"

msgid "Supertext"
msgstr "Supertext"

msgid "Connected. The API key works."
msgstr "Verbunden. Der API-Schlüssel funktioniert."

msgid "Connection"
msgstr "Verbindung"

msgid "Supertext is not the machine translator of this site. Set <code>WAGTAILLOCALIZE_MACHINE_TRANSLATOR</code> to <code>wagtail_supertext.SupertextTranslator</code> (see the installation guide)."
msgstr "Supertext ist nicht der maschinelle Übersetzer dieser Website. Setzen Sie <code>WAGTAILLOCALIZE_MACHINE_TRANSLATOR</code> auf <code>wagtail_supertext.SupertextTranslator</code> (siehe Installationsanleitung)."

msgid "API key"
msgstr "API-Schlüssel"

msgid "Set (SUPERTEXT_API_KEY environment variable)"
msgstr "Gesetzt (Umgebungsvariable SUPERTEXT_API_KEY)"

msgid "Set (Django settings)"
msgstr "Gesetzt (Django-Einstellungen)"

msgid "Missing"
msgstr "Fehlt"

msgid "No Supertext account yet? <a href=\"%(signup_url)s\" target=\"_blank\" rel=\"noopener\">Create one at supertext.com</a>. Generate your API key at <a href=\"%(api_key_url)s\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role), then set it as the <code>SUPERTEXT_API_KEY</code> environment variable."
msgstr "Noch kein Supertext-Konto? <a href=\"%(signup_url)s\" target=\"_blank\" rel=\"noopener\">Erstellen Sie eines auf supertext.com</a>. Erzeugen Sie Ihren API-Schlüssel unter <a href=\"%(api_key_url)s\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (erfordert die Rolle Admin) und setzen Sie ihn dann als Umgebungsvariable <code>SUPERTEXT_API_KEY</code>."

msgid "API"
msgstr "API"

msgid "Plugin version"
msgstr "Plugin-Version"

msgid "Test connection"
msgstr "Verbindung testen"

msgid "Languages"
msgstr "Sprachen"

msgid "Each target locale is sent to Supertext with this language code and tone. Change them with the <code>LANGUAGES</code> option."
msgstr "Jede Zielsprache wird mit diesem Sprachcode und dieser Anrede an Supertext gesendet. Ändern lässt sich das mit der Option <code>LANGUAGES</code>."

msgid "Locale"
msgstr "Sprache"

msgid "Supertext language"
msgstr "Supertext-Sprache"

msgid "Tone"
msgstr "Anrede"

msgid "Source language"
msgstr "Ausgangssprache"

msgid "Formal (Sie, vous)"
msgstr "Formell (Sie, vous)"

msgid "Informal (du, tu)"
msgstr "Informell (du, tu)"

msgid "Default"
msgstr "Standard"

msgid "Supertext could not translate: %(error)s"
msgstr "Supertext konnte nicht übersetzen: %(error)s"

msgid "Supertext did not return a file id."
msgstr "Supertext hat keine Datei-ID zurückgegeben."

msgid "Supertext could not translate the document."
msgstr "Supertext konnte das Dokument nicht übersetzen."

msgid "Your Supertext translation limit is exceeded. Please upgrade your subscription."
msgstr "Ihr Supertext-Übersetzungslimit ist überschritten. Bitte erweitern Sie Ihr Abonnement."

msgid "The document was deleted at Supertext before it could be downloaded."
msgstr "Das Dokument wurde bei Supertext gelöscht, bevor es heruntergeladen werden konnte."

msgid "Timed out waiting for the Supertext translation."
msgstr "Zeitüberschreitung beim Warten auf die Supertext-Übersetzung."

msgid "The translated document was empty."
msgstr "Das übersetzte Dokument war leer."

msgid "No Supertext API key is configured. No Supertext account yet? Create one at %(signup_url)s. Generate your API key at %(api_key_url)s (supertext.com → Integrations → API, requires the Admin role)."
msgstr "Es ist kein Supertext-API-Schlüssel konfiguriert. Noch kein Supertext-Konto? Erstellen Sie eines auf %(signup_url)s. Erzeugen Sie Ihren API-Schlüssel unter %(api_key_url)s (supertext.com → Integrations → API, erfordert die Rolle Admin)."

msgid "Could not reach Supertext: %(error)s"
msgstr "Supertext ist nicht erreichbar: %(error)s"

msgid "Authentication failed. Please check the Supertext API key. No Supertext account yet? Create one at %(signup_url)s. Generate a new API key at %(api_key_url)s (requires the Admin role)."
msgstr "Authentifizierung fehlgeschlagen. Bitte prüfen Sie den Supertext-API-Schlüssel. Noch kein Supertext-Konto? Erstellen Sie eines auf %(signup_url)s. Erzeugen Sie einen neuen API-Schlüssel unter %(api_key_url)s (erfordert die Rolle Admin)."

msgid "The requested Supertext resource was not found."
msgstr "Die angeforderte Supertext-Ressource wurde nicht gefunden."

msgid "The content is too large for Supertext to translate in one go."
msgstr "Der Inhalt ist zu groß, um von Supertext in einem Durchgang übersetzt zu werden."

msgid "Too many requests to Supertext. Please try again shortly."
msgstr "Zu viele Anfragen an Supertext. Bitte versuchen Sie es in Kürze erneut."

msgid "The Supertext service is currently unavailable."
msgstr "Der Supertext-Dienst ist derzeit nicht verfügbar."

msgid "Supertext answered with HTTP %(code)s."
msgstr "Supertext hat mit HTTP %(code)s geantwortet."
